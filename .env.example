# Copy to .env and fill in real values. .env is gitignored — never commit it.
#   cp .env.example .env
#
# Each key serves exactly one stage of the pipeline. Nothing here is optional
# except the routing provider you don't pick.

# ─────────────────────────────────────────────────────────────────────────────
# M0 — VOICE NOTE TRANSCRIPTION (ASR)
# Provider: Groq   Model: whisper-large-v3-turbo
# Scope: 13 .mp3 files in dataset/media/audio (~4.4 MB total)
# Free tier: 2,000 requests/day, 7,200 audio-seconds/hour, 25 MB max file size
# Get one at: https://console.groq.com  (no credit card)
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# M0 — IMAGE OCR + DESCRIPTION (vision)
# Provider: Google AI Studio   Model: see GEMINI_VISION_MODEL below
# Scope: 20 .jpg files in dataset/media/images (~7.0 MB total)
#
# MEASURED free-tier reality (2026-08-01), not the marketing number:
#   * gemini-2.5-flash is retired for new keys — it is still listed by the
#     models endpoint but returns 404 "no longer available to new users".
#   * gemini-3.6-flash free tier is 20 requests/DAY. That is exactly our image
#     count, with zero headroom for a retry or a prompt change.
#   * Quota pools are per-model, so gemini-3.5-flash is a separate 20/day
#     bucket. Switch GEMINI_VISION_MODEL when one is exhausted.
# This is survivable only because extraction runs once and is committed to
# code/cache/media.json — the router never calls Gemini. See DECISIONS.md.
# Get one at: https://aistudio.google.com/apikey  (no credit card)
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash

# ─────────────────────────────────────────────────────────────────────────────
# M2/M3 — ROUTING DECISIONS (safety gate + personalization)
# Scope: 110 messages in dataset/messages.csv
# Two candidates; set ROUTER_PROVIDER to pick, and fill in that one's key.
# We benchmark both against dataset/sample_messages.csv before committing.
# ─────────────────────────────────────────────────────────────────────────────
ROUTER_PROVIDER=anthropic          # anthropic | nvidia

# Vision provider for M0 image extraction: gemini | nim | both
# ("both" runs each in turn and writes code/cache/vision_comparison.md)
VISION_PROVIDER=gemini
NIM_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

# Candidate A — Anthropic Claude Haiku 4.5 (model id: claude-haiku-4-5)
# Paid: $1.00 / $5.00 per million input / output tokens.
# Full 110-message run costs well under $1, so cost is not a real constraint.
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Candidate B — NVIDIA NIM (OpenAI-compatible, base URL below)
# Free: 1,000 inference credits on signup (up to 5,000 on request), 40 req/min.
# Key format is nvapi-...
# Get one at: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
